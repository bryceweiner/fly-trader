# /srv/fly/custody.env (mode 600): the treasury setup and the caps, read by BOTH the signer and the brain.
# Nothing secret: all of it is visible on chain or harmless. Comments on their own lines only.
# The steps that create the multisig and its limits: fly-trader vault squads-setup (inside the fly container).

# the Squads v4 multisig whose vault 0 is the treasury (members: your owner wallets only; never a server key)
VAULT_MULTISIG=
# L1: SOL, daily, member = the trading key, the ONLY destination = the trading wallet
VAULT_LIMIT_TRADING=
# L2: SOL, weekly, member = the payout key, any destination (claims)
VAULT_LIMIT_PAYOUT=
# the most SOL the trading wallet keeps (positions are sized on the whole book, spent from this float)
TREASURY_FLOAT_SOL=2.0
TOPUP_MIN_SOL=0.1
# per-buy cap (the signer refuses larger buys; the Kelly caps usually size below it)
MAX_POSITION_SOL=0.5
# the signer's own limits: SOL bought per day, swaps per minute, priority fee per swap, the worst value a swap may return
SIGNER_DAILY_BUY_SOL=10
SIGNER_SWAPS_PER_MIN=6
SIGNER_MAX_PRIORITY_SOL=0.005
SIGNER_MIN_VALUE_RATIO=0.6
# your age1... public key: the signer encrypts the two hot keys to it for the off-box backup (NOT the release key)
VAULT_BACKUP_RECIPIENT=
