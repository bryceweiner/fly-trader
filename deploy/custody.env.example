# /srv/fly/custody.env (mode 600): the treasury setup and the caps, read by BOTH the signer and the brain.
# Nothing secret: all of it is visible on chain or harmless. Comments on their own lines only.
# Create the multisig and its limits on https://fly-trader.app/owner.html with your owner wallet (docs/vault/RUNBOOK.md
# section 4.3); the page prints the three lines below. After changing any value: sudo python3 /usr/local/lib/fly/fly_update.py restart

# the Squads v4 multisig whose vault 0 is the treasury (members: your owner wallets only; never a server key)
VAULT_MULTISIG=
# L1: SOL, daily, member = the trading key, the ONLY destination = the trading wallet. A new limit has a new address.
VAULT_LIMIT_TRADING=
# L2: SOL, weekly, member = the payout key, any destination (claims)
VAULT_LIMIT_PAYOUT=
# the most SOL the trading wallet keeps (positions are sized on the whole book, spent from this float); also the largest
# single top-up the signer signs. Moves smaller than TOPUP_MIN_SOL are skipped.
TREASURY_FLOAT_SOL=2.0
TOPUP_MIN_SOL=0.1
# the fixed size for a model without a sizing table (sizing is otherwise MAX_POSITION_FRACTION of the book); must be > 0
MAX_POSITION_SOL=0.5
# the signer refuses any buy larger than this (a bound on a compromised brain, not sizing)
SIGNER_MAX_BUY_SOL=0.6
# the signer's own limits: SOL bought per day, swaps per minute, priority fee per swap, the worst value a swap may return
SIGNER_DAILY_BUY_SOL=10
SIGNER_SWAPS_PER_MIN=6
SIGNER_MAX_PRIORITY_SOL=0.005
SIGNER_MIN_VALUE_RATIO=0.6
# your age1... public key (NOT the release key): the signer encrypts the two hot keys to it, the brain the nightly ledger
VAULT_BACKUP_RECIPIENT=
