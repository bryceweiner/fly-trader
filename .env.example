# fly-trader distribution -- copy to .env and fill in the two API keys. Everything else is set for a 0.5 SOL wallet.
# Keep values bare: Docker Compose keeps a trailing "# comment" as part of an empty value, so comments live on their own lines.

# --- keys (never logged) ---
# Helius: https://dashboard.helius.dev (RPC for balances and transactions)
HELIUS_API_KEY=
# Jupiter: https://portal.jup.ag (swaps and token stats)
JUPITER_API_KEY=

# --- database (docker-compose.yml sets the container's URL; this one is for running outside Docker) ---
DATABASE_URL=postgresql:///fly_trader

# --- money ---
# Live money. Until the wallet is funded the engine trades paper and says so on the console.
LIVE_ENABLED=1
# What you fund the wallet with; also the paper warm-up bankroll.
CAPITAL_SOL=0.5
# Hard cap per position.
MAX_POSITION_SOL=0.05
# Per position, of the bankroll minus the gas reserve.
MAX_POSITION_FRACTION=0.10
# Per position, of the pool's SOL reserve (bounds price impact).
MAX_POOL_SHARE=0.02
# Smaller sizes are skipped.
MIN_POSITION_SOL=0.02
# Never spent (fees and token-account rent).
GAS_RESERVE_SOL=0.05
KELLY_FRACTION=0.25

# --- rails ---
# 20 % below the wallet's peak: stop entering ...
KILL_SWITCH_DRAWDOWN=0.20
# ... and sell everything open. Clear it on the console's "Safety & wallet" page or with `fly-trader reset-circuit --kill`.
KILL_SWITCH_LIQUIDATE=1

# --- paper warm-up, then live ---
# No minimum racing time; after 20 closed paper trades the fly trades the wallet; no race against the paper selector.
HANDOVER_DAYS=0
HANDOVER_MIN_TRADES=20
HANDOVER_BEAT_SELECTOR=0
# A restart keeps the paper book, so the warm-up count survives it.
RESET_ON_START=0

# --- runtime ---
SOLANA_CLUSTER=mainnet-beta
# auto: an NVIDIA GPU when the container has one (docker-compose.cuda.yml), else the CPU. Or cpu | cuda | cuda:1.
DEVICE=auto
# Batch sizes are derived from the device's free memory; on a shared GPU cap what the fly may use, in GB.
# DEVICE_MEMORY_GB=
DATA_DIR=data
LOG_DIR=logs

# --- staying current ---
# Every UPDATE_INTERVAL_S the container asks Hugging Face whether HF_REPO has a new release; if so it downloads the new
# code and model, restarts itself (about a minute; open positions are untouched) and keeps the previous release for a
# rollback if the new one fails to start. AUTO_UPDATE=0 pins this install to what it was built from.
AUTO_UPDATE=1
HF_REPO=bryceweiner/fly-trader
UPDATE_INTERVAL_S=3600
