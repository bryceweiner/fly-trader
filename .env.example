# --- secrets (never logged) ---
HELIUS_API_KEY=             # live execution only (RPC)
JUPITER_API_KEY=            # token stats; live swaps
BOT_PRIVATE_KEY=            # written by `fly-trader wallet new`; base58 64-byte secret
# --- database ---
DATABASE_URL=postgresql:///fly_trader
# --- bankroll and sizing ---
CAPITAL_SOL=5
GAS_RESERVE_SOL=0.30
KELLY_FRACTION=0.25         # share of the growth-optimal bet for the score's band
MAX_POSITION_FRACTION=0.10  # largest position, of the bankroll minus the reserve
MAX_POOL_SHARE=0.02         # largest position, of the pool's SOL reserve
MAX_POSITION_SOL=0.1        # fixed size for a model without a sizing table
# --- chain / execution (default-deny) ---
SOLANA_CLUSTER=mainnet-beta
LIVE_ENABLED=0              # 1 enables signing on mainnet; requires CAPITAL_SOL, MAX_POSITION_SOL, GAS_RESERVE_SOL
KILL_SWITCH_DRAWDOWN=0.30
# --- fly ---
DEVICE=auto                 # auto: CUDA if present, else Apple MPS, else CPU. Or cpu | cuda | cuda:1 | mps
# DEVICE_MEMORY_GB=8        # batch sizes are derived from free memory; set this to cap them (a shared GPU, a container limit)
# --- paths ---
DATA_DIR=data
LOG_DIR=logs
