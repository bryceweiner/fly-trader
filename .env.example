# fly-trader distribution -- ./install.sh copies this to .env and asks for the two API keys (or copy it and fill them
# in yourself). Everything else is set for a 0.5 SOL wallet. After changing a value: docker compose up -d --force-recreate fly
# (a plain restart keeps the values the container was created with).
# Keep values bare: Docker Compose keeps a trailing "# comment" as part of an empty value, so comments live on their own lines.

# --- keys (never logged) ---
# Helius: https://dashboard.helius.dev (RPC for balances and transactions; also the signer's, unless SIGNER_RPC_URL is set)
HELIUS_API_KEY=
# Jupiter: https://portal.jup.ag (swaps, through Jupiter's own Metis routes only, and token stats)
JUPITER_API_KEY=
# The bot key: `docker compose exec fly fly-trader wallet new` appends BOT_PRIVATE_KEY=... to this file. Do not add an
# empty BOT_PRIVATE_KEY= line yourself: wallet new refuses when the name is already here.
# Optional: a second Solana RPC from another provider for the signer, which simulates every swap before signing it.
# SIGNER_RPC_URL=

# --- database (docker-compose.yml sets the container's URL; this one is for running outside Docker) ---
DATABASE_URL=postgresql:///fly_trader

# --- money ---
# Live money. Until the wallet is funded the engine trades paper and says so on the console.
LIVE_ENABLED=1
# What you fund the wallet with; also the paper warm-up bankroll.
CAPITAL_SOL=0.5
# The fixed size for a model without a sizing table (the shipped fly has one); must be above 0 to trade live.
MAX_POSITION_SOL=0.05
# Per position, of the bankroll minus the gas reserve.
MAX_POSITION_FRACTION=0.10
# Per position, of the pool's SOL reserve (bounds price impact).
MAX_POOL_SHARE=0.02
# Smaller sizes are skipped.
MIN_POSITION_SOL=0.02
# Never spent (fees and token-account rent).
GAS_RESERVE_SOL=0.05
KELLY_FRACTION=0.25
# The signer's own limits (defaults shown): SOL per buy, SOL of buys per day, swaps per minute (buys and sells), priority
# fee per swap, and the least value a swap may return for what it costs, at the signer's own Jupiter prices.
# SIGNER_MAX_BUY_SOL=1
# SIGNER_DAILY_BUY_SOL=10
# SIGNER_SWAPS_PER_MIN=6
# SIGNER_MAX_PRIORITY_SOL=0.005
# SIGNER_MIN_VALUE_RATIO=0.6

# --- rails ---
# 20 % below the wallet's peak: stop entering ...
KILL_SWITCH_DRAWDOWN=0.20
# ... and sell everything open. Clear it on the console's "Safety & wallet" page or with `fly-trader reset-circuit --kill`.
KILL_SWITCH_LIQUIDATE=1

# --- paper warm-up, then live ---
# No minimum racing time; after 20 closed paper trades the fly trades the wallet; no race against the paper selector.
HANDOVER_DAYS=0
HANDOVER_MIN_TRADES=20
HANDOVER_BEAT_SELECTOR=0
# 1: the wallet trades as soon as it is funded and signing is allowed, without waiting for those paper trades (the fly's
# teacher-gated buys, i.e. the selector's buys and sizes less what the fly's learning vetoes). After funding, stop the
# container and run `fly-trader reset-paper` to restart the paper books from CAPITAL_SOL.
LIVE_WITHOUT_HANDOVER=0
# A restart keeps the paper book, so the warm-up count survives it.
RESET_ON_START=0

# --- Robinhood Chain memecoins (Pons launches graduated into Uniswap v4; money in ETH) ---
# Off by default. 1 = index Robinhood Chain (the rh_stream worker) and paper-trade it in ETH beside Solana. Indexing needs
# an Envio HyperSync token (ENVIO_API_TOKEN below; the free tier works, slower) -- the public RPC is far too slow for
# the backfill -- and disk for the history: ~30 GB from 2026-08-04. RH_START_DAY a ~40 days back indexes much less
# (the RH models need about a month of history per wallet); the RH books trade once the stream reaches the present.
RH_ENABLED=0
# ENVIO_API_TOKEN=
# RH_START_DAY=2026-08-04
# Real RH transactions stay off: the RH books trade paper until you set 1 and add the key and address below.
RH_LIVE_ENABLED=0
# 1 = the rehearsal chain (46630); the guard refuses any other chain id than the one selected here.
RH_TESTNET=0
# RPCs (defaults shown): logs from HyperSync (the official RPC when HyperSync fails), transactions from the official RPC,
# block headers from PublicNode. A QuickNode Robinhood Chain endpoint, if you have one, serves the transactions.
# RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# RH_RPC_URL_BLOCKS=https://robinhood-rpc.publicnode.com
# QUICKNODE_RH_API_URL=
# The address RH_BOT_PRIVATE_KEY must derive to (a guard, not a secret). Needed only for live.
RH_BOT_ADDRESS=
# RH_BOT_PRIVATE_KEY (hex) goes in this .env only, on its own line, when you enable live. It is read from here at run
# time and never baked into the image. Do not leave an empty RH_BOT_PRIVATE_KEY= line.

# --- runtime ---
SOLANA_CLUSTER=mainnet-beta
# auto: an NVIDIA or AMD GPU when the container has one (docker-compose.cuda.yml / docker-compose.rocm.yml), else the CPU.
# Or cpu | cuda | cuda:1 | rocm | rocm:1.
DEVICE=auto
# Batch sizes are derived from the device's free memory; on a shared GPU cap what the fly may use, in GB.
# DEVICE_MEMORY_GB=
# docker-compose.yml sets these to /app/data and /app/logs, your ./data and ./logs
DATA_DIR=data
LOG_DIR=logs

# --- staying current ---
# Every UPDATE_INTERVAL_S the container asks Hugging Face whether HF_REPO has a new release. It installs one only if it is
# signed by a key in release/allowed_signers and newer than the installed one, and every file matches the signed
# manifest; then it restarts itself (about a minute; open positions are untouched) and keeps the previous release for a
# rollback if the new one fails to start. AUTO_UPDATE=0 pins this install to what it was built from.
AUTO_UPDATE=1
HF_REPO=bryceweiner/fly-trader
UPDATE_INTERVAL_S=3600

# --- the console ---
# The console has no login. Compose publishes it on CONSOLE_PUBLISH: 127.0.0.1 is this machine only; 0.0.0.0 every device
# on your network -- a network you trust only, never forwarded to the internet. It answers only requests addressed to
# localhost, 127.0.0.1 or a name listed in CONSOLE_ALLOWED_HOSTS (comma-separated: this machine's network address, its
# name, a Tailscale name).
CONSOLE_PUBLISH=127.0.0.1
CONSOLE_ALLOWED_HOSTS=
