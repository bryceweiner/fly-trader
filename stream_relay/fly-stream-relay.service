[Unit]
Description=fly-trader stream relay (PumpAPI's firehose, filtered and forwarded over TLS)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/fly-stream-relay.env
# glibc's thread cache keeps freed events from merging: with it on, the heap grows ~24 MB/h once the buffer is full
Environment=GLIBC_TUNABLES=glibc.malloc.tcache_count=0
ExecStart=/opt/fly-stream-relay/venv/bin/python /opt/fly-stream-relay/relay.py
User=flyrelay
Group=flyrelay
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/fly-stream-relay

[Install]
WantedBy=multi-user.target
